{
  "name": "create-nodepress",
  "version": "0.0.0",
  "description": "Create a NodePress site: asks a few questions and writes a ready-to-run project folder",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-nodepress": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
