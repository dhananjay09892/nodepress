{
  "name": "@nodepress/core",
  "version": "0.0.0",
  "description": "NodePress kernel: hooks, plugins and lifecycle",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "sharp": "^0.35.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nodepress/db": "workspace:*"
  }
}
