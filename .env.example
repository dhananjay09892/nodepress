# Copy to .env for `docker compose up -d`. Never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
SITE_NAME=My Site
# The public address, for example https://example.com (used in links, the sitemap and the feed).
SITE_URL=
# Keep true behind HTTPS. Set to false only to try the site over plain http://localhost.
COOKIE_SECURE=true
# Set to true behind a reverse proxy (so client addresses and https are read from X-Forwarded-*).
TRUST_PROXY=false
# 16+ characters each; leave empty for a random value on every start.
CONTACT_SECRET=
WEBHOOK_SIGNING_KEY=
PORT=3000
