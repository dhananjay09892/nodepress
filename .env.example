# Copy to .env for `docker compose up -d`. Never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Optional: the first administrator. Leave both empty to use the setup wizard at /install.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
SITE_NAME=My Site
# The public address, for example https://example.com (used in links, the sitemap and the feed).
SITE_URL=
# Keep true behind HTTPS. Set to false only to try the site over plain http://localhost.
COOKIE_SECURE=true
# Set to true behind a reverse proxy (so client addresses and https are read from X-Forwarded-*).
TRUST_PROXY=false
# 16+ characters each; leave empty for a random value on every start.
CONTACT_SECRET=
# Contact form mail: where messages go, and the SMTP server that sends them (smtps:// uses TLS from
# the start). Without MAIL_URL and MAIL_FROM messages are only kept and logged.
CONTACT_TO=
MAIL_URL=
MAIL_FROM=
WEBHOOK_SIGNING_KEY=
# Uploads: empty or "local" keeps files on disk (MEDIA_DIR); "s3" uses an S3-compatible bucket
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2). S3_ENDPOINT is only for non-AWS services;
# S3_PUBLIC_URL serves files straight from the bucket or a CDN instead of through /uploads.
MEDIA_STORAGE=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Setup code for the web installer (8+ characters). Empty: a random one is printed in the server log.
INSTALL_CODE=
PORT=3000
